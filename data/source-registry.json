  "research_notes": {
    "launch_dataset": {
      "updated_at": "2026-05-03",
      "data_file": "data/incidents.json + data/northern-incidents.json",
      "record_count": 18,
      "period_focus": "late 2025 through May 2026, with one May/June 2025 workplace-death backfill to broaden the workplace-safety baseline",
      "coverage_notes": [
        "Whole-island coverage is represented with neutral district / area labels.",
        "Island-wide labour actions use area-centroid placement and explicit location_basis notes.",
        "No public current-labour-arrest record is included at launch; the Ahmet Tugcu record is marked released based on follow-up reporting.",
        "Northern Cyprus coverage is supplemented with Turkish-language sources in data/northern-incidents.json."
      ]
    },
